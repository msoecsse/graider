{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "sourceMap": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": ["node", "electron"]
  },
  "include": ["electron/**/*.ts"],
  // Test files and their helpers are type-checked by tsconfig.electron-test.json; emitting them
  // here shipped roughly half of dist-electron (and the packaged app) as compiled test code.
  "exclude": ["electron/**/*.test.ts", "electron/testSupport/**/*.ts"]
}
