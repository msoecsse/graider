{
  "name": "@graider/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Graider desktop UI shell.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:electron": "tsc --project tsconfig.node.json && node scripts/write-electron-package-type.cjs && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc --project tsconfig.node.json && node scripts/write-electron-package-type.cjs && vite build",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "jsdom": "latest",
    "typescript": "~5.9.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
