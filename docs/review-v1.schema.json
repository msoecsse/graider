{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "reviewId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "properties": {
        "courseCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "termCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "assignmentSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["courseCode", "termCode", "assignmentSlug"],
      "additionalProperties": false
    },
    "student": {
      "type": "object",
      "properties": {
        "githubUsername": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["githubUsername"]
        },
        {
          "required": ["studentId"]
        }
      ]
    },
    "repository": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "reviewedCommitSha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": ["owner", "name", "reviewedCommitSha"],
      "additionalProperties": false
    },
    "findings": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "deduction": {
            "type": "number",
            "minimum": 0
          },
          "rubric": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "additionalProperties": false,
            "anyOf": [
              {
                "required": ["id"]
              },
              {
                "required": ["name"]
              }
            ]
          },
          "tags": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "sourceLocation": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000,
                "pattern": "^(?![A-Za-z]:)(?!.*[\\\\\\u0000-\\u001f\\u007f])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))[^/]+(?:\\/[^/]+)*$"
              },
              "startLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "endLine": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "excerpt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100000
              }
            },
            "required": ["file", "startLine", "endLine", "excerpt"],
            "additionalProperties": false
          }
        },
        "required": ["id", "deduction"],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": ["title"]
          },
          {
            "required": ["text"]
          }
        ]
      }
    }
  },
  "required": ["schemaVersion", "reviewId", "assignment", "student", "repository", "findings"],
  "additionalProperties": false,
  "$id": "https://graider.app/schemas/review-v1.schema.json",
  "$comment": "Also enforce unique finding IDs, title or text, student identity, rubric ID or name, ordered ranges and excerpt line count. See review-import.md."
}
