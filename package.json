{
  "name": "graider",
  "version": "0.1.0",
  "description": "CLI-based GitHub assignment management for course repositories.",
  "type": "module",
  "bin": {
    "graider": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "packageManager": "npm@11.13.0",
  "scripts": {
    "build": "tsup src/cli/index.ts --format esm --dts --clean --out-dir dist",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run tests/live",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate:release": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build && npm --prefix ui run typecheck && npm --prefix ui test && npm --prefix ui run build && npm --prefix ui run package",
    "audit": "npm audit --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "keywords": [
    "github",
    "education",
    "cli",
    "grading"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@octokit/rest": "latest",
    "commander": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^25.9.1",
    "eslint": "latest",
    "jiti": "^2.7.0",
    "prettier": "latest",
    "tsup": "latest",
    "tsx": "^4.22.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
